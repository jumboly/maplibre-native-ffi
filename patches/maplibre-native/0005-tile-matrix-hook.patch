@@ -421,6 +421,13 @@ ProjectionMode Map::getProjectionMode() const {
     return impl->transform.getProjectionMode();
 }
 
+// MARK: - Tile matrix hook
+
+void Map::setTileMatrixHook(TileMatrixHook hook) {
+    impl->transform.setTileMatrixHook(std::move(hook));
+    impl->onUpdate();
+}
