diff --git a/include/mbgl/map/tile_matrix_hook.hpp b/include/mbgl/map/tile_matrix_hook.hpp
new file mode 100644
index 0000000..702f0d0
--- /dev/null
+++ b/include/mbgl/map/tile_matrix_hook.hpp
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <mbgl/util/mat4.hpp>
+
+#include <functional>
+
+namespace mln {
+
+class TransformState;
+class UnwrappedTileID;
+
+// Experimental hook that replaces the per-tile matrix computed by
+// TransformState::matrixFor. The hook receives the default tile matrix
+// (tile-local coordinates to world pixels) already written to `tileMatrix`
+// and may overwrite it in place; leaving it untouched keeps the default
+// behavior. TransformState instances are copied by value across render,
+// placement, and tile-cover code paths, so the hook shares one underlying
+// callable between threads and must be stateless and thread-safe.
+using TileMatrixHook =
+    std::function<void(mat4& tileMatrix, const UnwrappedTileID& tileID, const TransformState& state)>;
+
+} // namespace mln
diff --git a/src/mbgl/map/map.cpp b/src/mbgl/map/map.cpp
