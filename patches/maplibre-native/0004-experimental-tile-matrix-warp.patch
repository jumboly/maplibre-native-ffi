+// Experimental instrumentation for the render-crs phase-1 hypothesis check:
+// MLN_TILE_MATRIX_WARP holds 16 comma-separated numbers forming a column-major
+// mat4 that is left-multiplied onto every tile matrix, i.e. a warp applied in
+// world (mercator pixel) space. Parsed once because matrixFor runs for every
+// tile on every frame. Unset means upstream behavior.
+const mat4* experimentalTileMatrixWarp() {
+    static const std::optional<mat4> warp = []() -> std::optional<mat4> {
+        const char* spec = std::getenv("MLN_TILE_MATRIX_WARP");
+        if (!spec) {
+            return std::nullopt;
+        }
+        mat4 parsed;
+        const char* cursor = spec;
+        for (double& element : parsed) {
+            char* end = nullptr;
+            element = std::strtod(cursor, &end);
+            if (end == cursor) {
+                Log::Error(Event::General, "Ignoring malformed MLN_TILE_MATRIX_WARP (expected 16 numbers)");
+                return std::nullopt;
+            }
+            cursor = end;
+            while (*cursor == ',' || *cursor == ' ') {
+                ++cursor;
+            }
+        }
+        return parsed;
+    }();
+    return warp ? &*warp : nullptr;
+}
+
+} // namespace
